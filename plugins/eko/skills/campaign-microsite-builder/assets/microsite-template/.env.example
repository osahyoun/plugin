# Upstream Champaign API. Pronto currently uses the same service boundary.
CHAMPAIGN_API_HOST=https://actions.eko.org

# Server-only credential forwarded to protected Champaign routes.
VERCEL_SECRET=

# Optional local port.
PORT=4173

# Optional override. A config generated with demoMode=true always remains a demo.
MICROSITE_DEMO_MODE=false

# Optional Cloudflare Turnstile protection for donation submissions.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
REQUIRE_TURNSTILE=false
REQUIRE_DEVICE_DATA=true
